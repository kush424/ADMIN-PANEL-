<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Signup - Admin Panel</title>
    <link rel="stylesheet" href="/assets/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.base.css">
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
<div class="container-scroller">
    <div class="container-fluid page-body-wrapper full-page-wrapper">
        <div class="content-wrapper d-flex align-items-center auth px-0">
            <div class="row w-100 mx-0">
                <div class="col-lg-5 mx-auto">
                    <div class="auth-form-light text-left py-5 px-4 px-sm-5">

                        <div class="brand-logo text-center mb-4">
                            <img src="/assets/images/logo.svg" alt="logo" style="height:50px;">
                            <h4 class="mt-2 fw-bold">StarAdmin</h4>
                        </div>

                        <h4 class="mb-1">New here?</h4>
                        <h6 class="fw-light mb-4 text-muted">Fill in the details to create your account.</h6>

                        <% if (error) { %>
                            <div class="alert alert-danger">
                                <i class="mdi mdi-alert-circle me-2"></i><%= error %>
                            </div>
                        <% } %>

                        <form action="/signup" method="POST">

                            <div class="form-group">
                                <label>Full Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="mdi mdi-account-outline text-primary"></i>
                                    </span>
                                    <input type="text" name="name" class="form-control form-control-lg"
                                        placeholder="Enter Full Name" required>
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Username <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="mdi mdi-at text-primary"></i>
                                    </span>
                                    <input type="text" name="username" class="form-control form-control-lg"
                                        placeholder="Enter Username" required>
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Email Address <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="mdi mdi-email-outline text-primary"></i>
                                    </span>
                                    <input type="email" name="email" class="form-control form-control-lg"
                                        placeholder="Enter Email" required>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label>Mobile No <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white">
                                            <i class="mdi mdi-phone-outline text-primary"></i>
                                        </span>
                                        <input type="tel" name="mobile" class="form-control"
                                            placeholder="Mobile Number" required>
                                    </div>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label>Gender <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white">
                                            <i class="mdi mdi-gender-male-female text-primary"></i>
                                        </span>
                                        <select name="gender" class="form-control" required>
                                            <option value="">Select Gender</option>
                                            <option value="Male">Male</option>
                                            <option value="Female">Female</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Password <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="mdi mdi-lock-outline text-primary"></i>
                                    </span>
                                    <input type="password" name="password" id="passwordField"
                                        class="form-control form-control-lg"
                                        placeholder="Enter Password" required>
                                    <span class="input-group-text bg-white" style="cursor:pointer;"
                                        onclick="togglePass('passwordField', 'eye1')">
                                        <i class="mdi mdi-eye-outline text-primary" id="eye1"></i>
                                    </span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Confirm Password <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="mdi mdi-lock-outline text-primary"></i>
                                    </span>
                                    <input type="password" name="confirmPassword" id="confirmField"
                                        class="form-control form-control-lg"
                                        placeholder="Confirm Password" required>
                                    <span class="input-group-text bg-white" style="cursor:pointer;"
                                        onclick="togglePass('confirmField', 'eye2')">
                                        <i class="mdi mdi-eye-outline text-primary" id="eye2"></i>
                                    </span>
                                </div>
                            </div>

                            <div class="mt-3 d-grid">
                                <button type="submit" class="btn btn-block btn-primary btn-lg font-weight-medium auth-form-btn">
                                    <i class="mdi mdi-account-plus me-2"></i>Create Account
                                </button>
                            </div>

                            <div class="text-center mt-4 fw-light">
                                Already have account? <a href="/signin" class="text-primary">Sign In</a>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/assets/vendors/js/vendor.bundle.base.js"></script>
<script>
function togglePass(fieldId, iconId) {
    const f = document.getElementById(fieldId);
    const i = document.getElementById(iconId);
    if (f.type === 'password') {
        f.type = 'text';
        i.classList.replace('mdi-eye-outline', 'mdi-eye-off-outline');
    } else {
        f.type = 'password';
        i.classList.replace('mdi-eye-off-outline', 'mdi-eye-outline');
    }
}
</script>
</body>
</html>