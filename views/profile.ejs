<%- include('header') %>

<div class="container-scroller">
    <nav class="navbar default-layout col-lg-12 col-12 p-0 fixed-top d-flex align-items-top flex-row">
        <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-start">
            <div>
                <a class="navbar-brand brand-logo" href="/dashboard">
                    <img src="/assets/images/logo.svg" alt="logo" />
                </a>
            </div>
        </div>
        <div class="navbar-menu-wrapper d-flex align-items-top">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown d-none d-lg-block user-dropdown">
                    <a class="nav-link" href="#" data-bs-toggle="dropdown">
                        <img class="img-xs rounded-circle" src="/assets/images/faces/face8.jpg" alt="Profile">
                    </a>
                    <div class="dropdown-menu dropdown-menu-right navbar-dropdown">
                        <div class="dropdown-header text-center">
                            <img class="img-md rounded-circle" src="/assets/images/faces/face8.jpg" alt="Profile">
                            <p class="mb-1 mt-3 fw-semibold"><%= user.name %></p>
                            <p class="fw-light text-muted mb-0"><%= user.email %></p>
                        </div>
                        <a class="dropdown-item" href="/profile">
                            <i class="dropdown-item-icon mdi mdi-account-outline text-primary me-2"></i>Profile
                        </a>
                        <a class="dropdown-item" href="/change-password">
                            <i class="dropdown-item-icon mdi mdi-lock-outline text-primary me-2"></i>Change Password
                        </a>
                        <a class="dropdown-item" href="/logout">
                            <i class="dropdown-item-icon mdi mdi-power text-primary me-2"></i>Sign Out
                        </a>
                    </div>
                </li>
            </ul>
        </div>
    </nav>

    <div class="container-fluid page-body-wrapper">
        <nav class="sidebar sidebar-offcanvas" id="sidebar">
            <ul class="nav">
                <li class="nav-item">
                    <a class="nav-link" href="/dashboard">
                        <i class="mdi mdi-grid-large menu-icon"></i>
                        <span class="menu-title">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="/profile">
                        <i class="mdi mdi-account-outline menu-icon"></i>
                        <span class="menu-title">Profile</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/change-password">
                        <i class="mdi mdi-lock-outline menu-icon"></i>
                        <span class="menu-title">Change Password</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/logout">
                        <i class="mdi mdi-power menu-icon"></i>
                        <span class="menu-title">Logout</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="main-panel">
            <div class="content-wrapper">
                <%- include('flash') %>

                <div class="row">
                    <div class="col-md-8 grid-margin stretch-card mx-auto">
                        <div class="card card-rounded">
                            <div class="card-body">
                                <h4 class="card-title card-title-dash mb-4">My Profile</h4>

                                <div class="text-center mb-4">
                                    <img src="/assets/images/faces/face8.jpg"
                                        class="rounded-circle mb-3"
                                        style="width:100px;height:100px;object-fit:cover;border:3px solid #727cf5;">
                                    <h4><%= user.name %></h4>
                                    <p class="text-muted"><%= user.email %></p>
                                </div>

                                <form action="/profile" method="POST">
                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label>Full Name</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white">
                                                    <i class="mdi mdi-account-outline text-primary"></i>
                                                </span>
                                                <input type="text" name="name" class="form-control"
                                                    value="<%= user.name %>" required>
                                            </div>
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Username</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white">
                                                    <i class="mdi mdi-at text-primary"></i>
                                                </span>
                                                <input type="text" name="username" class="form-control"
                                                    value="<%= user.username || '' %>">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label>Email</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white">
                                                    <i class="mdi mdi-email-outline text-primary"></i>
                                                </span>
                                                <input type="email" class="form-control"
                                                    value="<%= user.email %>" disabled>
                                            </div>
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Mobile</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white">
                                                    <i class="mdi mdi-phone-outline text-primary"></i>
                                                </span>
                                                <input type="tel" name="mobile" class="form-control"
                                                    value="<%= user.mobile || '' %>">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label>Gender</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white">
                                                    <i class="mdi mdi-gender-male-female text-primary"></i>
                                                </span>
                                                <select name="gender" class="form-control">
                                                    <option value="">Select Gender</option>
                                                    <option value="Male" <%= user.gender === 'Male' ? 'selected' : '' %>>Male</option>
                                                    <option value="Female" <%= user.gender === 'Female' ? 'selected' : '' %>>Female</option>
                                                    <option value="Other" <%= user.gender === 'Other' ? 'selected' : '' %>>Other</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="mdi mdi-content-save me-2"></i>Update Profile
                                        </button>
                                        <a href="/dashboard" class="btn btn-light btn-lg ms-2">Cancel</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <footer class="footer">
                <div class="d-sm-flex justify-content-center">
                    <span class="text-muted">Admin Panel &copy; 2026. All rights reserved.</span>
                </div>
            </footer>
        </div>
    </div>
</div>

<%- include('footer') %>