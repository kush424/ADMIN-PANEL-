<%- include('header') %>

<div class="container-scroller">
    <nav class="navbar default-layout col-lg-12 col-12 p-0 fixed-top d-flex align-items-top flex-row">
        <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-start">
            <a class="navbar-brand brand-logo" href="/dashboard">
                <img src="/assets/images/logo.svg" alt="logo" />
            </a>
        </div>
        <div class="navbar-menu-wrapper d-flex align-items-top">
            <ul class="navbar-nav">
                <li class="nav-item fw-semibold d-none d-lg-block ms-0">
                    <h1 class="welcome-text">Good Morning, <span class="text-black fw-bold"><%= user.name %></span></h1>
                    <h3 class="welcome-sub-text">Your admin panel summary</h3>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown d-none d-lg-block user-dropdown">
                    <a class="nav-link" href="#" data-bs-toggle="dropdown">
                        <img class="img-xs rounded-circle" src="/assets/images/faces/face8.jpg" alt="Profile">
                    </a>
                    <div class="dropdown-menu dropdown-menu-right navbar-dropdown">
                        <div class="dropdown-header text-center">
                            <img class="img-md rounded-circle" src="/assets/images/faces/face8.jpg" alt="Profile">
                            <p class="mb-1 mt-3 fw-semibold"><%= user.name %></p>
                            <p class="fw-light text-muted mb-0"><%= user.email %></p>
                        </div>
                        <a class="dropdown-item" href="/profile">
                            <i class="dropdown-item-icon mdi mdi-account-outline text-primary me-2"></i>Profile
                        </a>
                        <a class="dropdown-item" href="/change-password">
                            <i class="dropdown-item-icon mdi mdi-lock-outline text-primary me-2"></i>Change Password
                        </a>
                        <a class="dropdown-item" href="/logout">
                            <i class="dropdown-item-icon mdi mdi-power text-primary me-2"></i>Sign Out
                        </a>
                    </div>
                </li>
            </ul>
        </div>
    </nav>

    <div class="container-fluid page-body-wrapper">
        <%- include('sidebar') %>

        <div class="main-panel">
            <div class="content-wrapper">
                <%- include('flash') %>
                <div class="row">
                    <div class="col-lg-3 col-md-6 grid-margin stretch-card">
                        <div class="card card-rounded">
                            <div class="card-body">
                                <p class="statistics-title">Total Users</p>
                                <h3 class="rate-percentage">50</h3>
                                <p class="text-success d-flex"><i class="mdi mdi-menu-up"></i><span>+5%</span></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 grid-margin stretch-card">
                        <div class="card card-rounded">
                            <div class="card-body">
                                <p class="statistics-title">Total Orders</p>
                                <h3 class="rate-percentage">100</h3>
                                <p class="text-danger d-flex"><i class="mdi mdi-menu-down"></i><span>-1%</span></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 grid-margin stretch-card">
                        <div class="card card-rounded">
                            <div class="card-body">
                                <p class="statistics-title">Revenue</p>
                                <h3 class="rate-percentage">$573</h3>
                                <p class="text-success d-flex"><i class="mdi mdi-menu-up"></i><span>+1.37%</span></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 grid-margin stretch-card">
                        <div class="card card-rounded">
                            <div class="card-body">
                                <p class="statistics-title">New Sessions</p>
                                <h3 class="rate-percentage">68.8</h3>
                                <p class="text-danger d-flex"><i class="mdi mdi-menu-down"></i><span>-0.5%</span></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 grid-margin stretch-card">
                        <div class="card card-rounded">
                            <div class="card-body">
                                <h4 class="card-title card-title-dash">Session Information</h4>
                                <table class="table">
                                    <tr><td><strong>Name:</strong></td><td><%= user.name %></td></tr>
                                    <tr><td><strong>Email:</strong></td><td><%= user.email %></td></tr>
                                    <tr><td><strong>Username:</strong></td><td>@<%= user.username || '-' %></td></tr>
                                    <tr><td><strong>Mobile:</strong></td><td><%= user.mobile || '-' %></td></tr>
                                    <tr><td><strong>Gender:</strong></td><td><%= user.gender || '-' %></td></tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <footer class="footer">
                <div class="d-sm-flex justify-content-center">
                    <span class="text-muted">Admin Panel &copy; 2026. All rights reserved.</span>
                </div>
            </footer>
        </div>
    </div>
</div>

<%- include('footer') %>