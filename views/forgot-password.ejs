<%- include('header') %>
<%- include('flash') %>

<style>
  .fp-wrapper {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .fp-card {
    background: #fff;
    width: 100%;
    max-width: 400px;
    padding: 36px 32px;
    border-radius: 14px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    text-align: center;
  }
  .fp-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 16px;
    background: #eef2ff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
  }
  .fp-card h2 {
    margin: 0 0 8px;
    font-size: 22px;
    color: #1a1a2e;
  }
  .fp-card p {
    margin: 0 0 24px;
    color: #6b7280;
    font-size: 14px;
    line-height: 1.5;
  }
  .fp-input-group {
    text-align: left;
    margin-bottom: 20px;
  }
  .fp-input-group label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 6px;
  }
  .fp-input-group input {
    width: 100%;
    padding: 12px 14px;
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
    font-size: 15px;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }
  .fp-input-group input:focus {
    border-color: #6366f1;
  }
  .fp-btn {
    width: 100%;
    padding: 13px;
    background: #6366f1;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .fp-btn:hover {
    background: #4f46e5;
  }
  .fp-back {
    display: inline-block;
    margin-top: 18px;
    font-size: 13.5px;
    color: #6366f1;
    text-decoration: none;
  }
  .fp-back:hover {
    text-decoration: underline;
  }
</style>

<div class="fp-wrapper">
  <div class="fp-card">
    <div class="fp-icon">🔒</div>
    <h2>Forgot Your Password?</h2>
    <p>No worries, enter your registered email address and we'll send you an OTP.</p>

    <form action="/forgot-password" method="POST">
      <div class="fp-input-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com" autofocus />
      </div>

      <button type="submit" class="fp-btn">Send OTP</button>
    </form>

    <a href="/signin" class="fp-back">← Back to Sign In</a>
  </div>
</div>

<%- include('footer') %>
