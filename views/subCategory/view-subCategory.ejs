<%- include('../header') %>
<div class="container-scroller">
    <nav class="navbar default-layout col-lg-12 col-12 p-0 fixed-top d-flex align-items-top flex-row">
        <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-start">
            <a class="navbar-brand brand-logo" href="/dashboard">
                <img src="/assets/images/logo.svg" alt="logo" />
            </a>
        </div>
        <div class="navbar-menu-wrapper d-flex align-items-top">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown d-none d-lg-block user-dropdown">
                    <a class="nav-link" href="#" data-bs-toggle="dropdown">
                        <img class="img-xs rounded-circle" src="/assets/images/faces/face8.jpg" alt="Profile">
                    </a>
                    <div class="dropdown-menu dropdown-menu-right navbar-dropdown">
                        <div class="dropdown-header text-center">
                            <p class="mb-1 mt-3 fw-semibold"><%= user.name %></p>
                            <p class="fw-light text-muted mb-0"><%= user.email %></p>
                        </div>
                        <a class="dropdown-item" href="/profile"><i class="dropdown-item-icon mdi mdi-account-outline text-primary me-2"></i>Profile</a>
                        <a class="dropdown-item" href="/logout"><i class="dropdown-item-icon mdi mdi-power text-primary me-2"></i>Sign Out</a>
                    </div>
                </li>
            </ul>
        </div>
    </nav>
    <div class="container-fluid page-body-wrapper">
        <nav class="sidebar sidebar-offcanvas" id="sidebar">
            <ul class="nav">
                <li class="nav-item"><a class="nav-link" href="/dashboard"><i class="mdi mdi-grid-large menu-icon"></i><span class="menu-title">Dashboard</span></a></li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="collapse" href="#categoryMenu">
                        <i class="mdi mdi-tag-multiple menu-icon"></i><span class="menu-title">Category</span><i class="menu-arrow"></i>
                    </a>
                    <div class="collapse" id="categoryMenu">
                        <ul class="nav flex-column sub-menu">
                            <li class="nav-item"><a class="nav-link" href="/add-category">Add Category</a></li>
                            <li class="nav-item"><a class="nav-link" href="/view-category">View Category</a></li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="collapse" href="#subCategoryMenu" aria-expanded="true">
                        <i class="mdi mdi-tag menu-icon"></i><span class="menu-title">Sub Category</span><i class="menu-arrow"></i>
                    </a>
                    <div class="collapse show" id="subCategoryMenu">
                        <ul class="nav flex-column sub-menu">
                            <li class="nav-item"><a class="nav-link" href="/add-subCategory">Add Sub Category</a></li>
                            <li class="nav-item"><a class="nav-link active" href="/view-subCategory">View Sub Category</a></li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item"><a class="nav-link" href="/logout"><i class="mdi mdi-power menu-icon"></i><span class="menu-title">Logout</span></a></li>
            </ul>
        </nav>
        <div class="main-panel">
            <div class="content-wrapper">
                <%- include('../flash') %>
                <div class="row">
                    <div class="col-12 grid-margin stretch-card">
                        <div class="card card-rounded">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div>
                                        <h4 class="card-title card-title-dash mb-1">All Sub Categories</h4>
                                        <p class="text-muted mb-0">Total: <strong><%= subCategories.length %></strong></p>
                                    </div>
                                    <a href="/add-subCategory" class="btn btn-primary"><i class="mdi mdi-plus me-1"></i>Add Sub Category</a>
                                </div>
                                <form action="/view-subCategory" method="GET" class="mb-4">
                                    <div class="input-group" style="max-width:400px;">
                                        <input type="text" name="search" class="form-control" placeholder="Search..." value="<%= search %>">
                                        <button class="btn btn-primary" type="submit"><i class="mdi mdi-magnify"></i></button>
                                    </div>
                                </form>
                                <div class="table-responsive">
                                    <table class="table select-table align-middle">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Image</th>
                                                <th>Name</th>
                                                <th>Category</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (subCategories.length > 0) { %>
                                                <% subCategories.forEach((sub, index) => { %>
                                                <tr>
                                                    <td><%= (page-1)*10 + index + 1 %></td>
                                                    <td>
                                                        <img src="<%= sub.image !== 'default.jpg' ? '/images/' + sub.image : '/assets/images/faces/face8.jpg' %>"
                                                            style="width:45px;height:45px;object-fit:cover;border-radius:8px;">
                                                    </td>
                                                    <td><h6 class="mb-0"><%= sub.name %></h6></td>
                                                    <td><small><%= sub.category ? sub.category.name : '-' %></small></td>
                                                    <td>
                                                        <a href="/toggle-subCategory/<%= sub._id %>" class="badge <%= sub.status === 'Active' ? 'badge-opacity-success' : 'badge-opacity-danger' %>">
                                                            <%= sub.status %>
                                                        </a>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex gap-1">
                                                            <a href="/edit-subCategory/<%= sub._id %>" class="btn btn-sm btn-outline-primary"><i class="mdi mdi-pencil"></i></a>
                                                            <form action="/delete-subCategory/<%= sub._id %>" method="POST" style="display:inline;">
                                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete karna chahte ho?')"><i class="mdi mdi-delete"></i></button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="6" class="text-center py-5">
                                                        <i class="mdi mdi-tag-off text-muted" style="font-size:3rem;"></i>
                                                        <p class="mt-2 text-muted">Koi sub category nahi mili</p>
                                                    </td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                                <% if (totalPages > 1) { %>
                                <nav class="mt-3">
                                    <ul class="pagination justify-content-center">
                                        <% for(let i = 1; i <= totalPages; i++) { %>
                                            <li class="page-item <%= page === i ? 'active' : '' %>">
                                                <a class="page-link" href="/view-subCategory?page=<%= i %>&search=<%= search %>"><%= i %></a>
                                            </li>
                                        <% } %>
                                    </ul>
                                </nav>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <footer class="footer"><div class="d-sm-flex justify-content-center"><span class="text-muted">Admin Panel &copy; 2026.</span></div></footer>
        </div>
    </div>
</div>
<script src="/assets/vendors/js/vendor.bundle.base.js"></script>
<script src="/assets/js/off-canvas.js"></script>
<script src="/assets/js/template.js"></script>
<script src="/assets/js/settings.js"></script>
<script src="/assets/js/hoverable-collapse.js"></script>
<%- include('../footer') %>