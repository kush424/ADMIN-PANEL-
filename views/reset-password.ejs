<%- include('header') %>
<%- include('flash') %>

<style>
  .rp-wrapper {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .rp-card {
    background: #fff;
    width: 100%;
    max-width: 400px;
    padding: 36px 32px;
    border-radius: 14px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    text-align: center;
  }
  .rp-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 16px;
    background: #eef2ff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
  }
  .rp-card h2 {
    margin: 0 0 8px;
    font-size: 22px;
    color: #1a1a2e;
  }
  .rp-card p {
    margin: 0 0 24px;
    color: #6b7280;
    font-size: 14px;
    line-height: 1.5;
  }
  .rp-input-group {
    text-align: left;
    margin-bottom: 18px;
  }
  .rp-input-group label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 6px;
  }
  .rp-input-group input {
    width: 100%;
    padding: 12px 14px;
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
    font-size: 15px;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }
  .rp-input-group input:focus {
    border-color: #6366f1;
  }
  .rp-btn {
    width: 100%;
    padding: 13px;
    background: #6366f1;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .rp-btn:hover {
    background: #4f46e5;
  }
</style>

<div class="rp-wrapper">
  <div class="rp-card">
    <div class="rp-icon"></div>
   <h2>Create a New Password</h2>
<p>Choose a strong password to keep your account secure.</p>

    <form action="/reset-password" method="POST">
      <div class="rp-input-group">
        <label for="password">New Password</label>
        <input type="password" id="password" name="password" required minlength="6" placeholder="••••••••" />
      </div>

      <div class="rp-input-group">
        <label for="confirmPassword">Confirm Password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" placeholder="••••••••" />
      </div>

      <button type="submit" class="rp-btn">Reset Your Password</button>
    </form>
  </div>
</div>

<%- include('footer') %>
